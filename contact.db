# Create the "contact" database
use contact

# Create the "contactlist" collection and insert documents
db.contactlist.insertMany([
  { lastName: "Ben", firstName: "Moris", email: "ben@gmail.com", age: 26 },
  { lastName: "Kefi", firstName: "Seif", email: "kefi@gmail.com", age: 15 },
  { lastName: "Emilie", firstName: "Brouge", email: "emilie.b@gmail.com", age: 40 },
  { lastName: "Alex", firstName: "Brown", age: 4 },
  { lastName: "Denzel", firstName: "Washington", age: 3 }
])


display all contactlist
db.contactlist.find().pretty()

db.contactlist.findOne({ _id: ObjectId("PUT_ID_HERE") })

db.contactlist.find({ age: { $gt: 18 } }).pretty()

db.contactlist.find({
  $and: [
    { age: { $gt: 18 } },
    { firstName: /ah/i }  // Case insensitive regex for "ah" in first name
  ]
}).pretty()


db.contactlist.updateOne(
  { lastName: "Kefi", firstName: "Seif" },  // Find this record
  { $set: { firstName: "Anis" } }           // Update the first name
)

db.contactlist.deleteMany({ age: { $lt: 5 } })

